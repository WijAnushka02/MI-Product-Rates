    {
      "name": "2. MI Product Rates CRUD",
      "item": [
        {
          "name": "2.1 Create Rate (form-data with File)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 201 Created\", function () {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "",
                  "pm.test(\"Auto-generated sequential SR_ID (SR00X)\", function () {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData.sr_id).to.match(/^SR\\d{3,}$/);",
                  "    pm.collectionVariables.set(\"record_id\", jsonData.id);",
                  "    pm.collectionVariables.set(\"sr_id\", jsonData.sr_id);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "service",
                  "value": "Dark Fiber Inter-DC Core Link",
                  "type": "text"
                },
                {
                  "key": "executive_level",
                  "value": "Enterprise Tier 1",
                  "type": "text"
                },
                {
                  "key": "rate",
                  "value": "350000.50",
                  "type": "text"
                },
                {
                  "key": "created_user",
                  "value": "slt_admin",
                  "type": "text"
                },
                {
                  "key": "status",
                  "value": "Active",
                  "type": "text"
                },
                {
                  "key": "comments",
                  "value": "Created via Postman Collection test",
                  "type": "text"
                },
                {
                  "key": "attachment",
                  "type": "file",
                  "src": ""
                }
              ]
            },
            "url": {
              "raw": "{{base_url}}/api/mi-product-rates/",
              "host": ["{{base_url}}"],
              "path": ["api", "mi-product-rates", ""]
            }
          },
          "response": []
        },
        {
          "name": "2.2 Create Rate (raw JSON without File)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 201 Created\", function () {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "var jsonData = pm.response.json();",
                  "pm.expect(jsonData.rate).to.eql(85000.00);"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"service\": \"Cloud PBX Virtual Extension\",\n    \"executive_level\": \"Silver Corporate\",\n    \"rate\": 85000.00,\n    \"created_user\": \"anushka_intern\",\n    \"status\": \"Active\",\n    \"comments\": \"Standard enterprise cloud telephony tier\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/mi-product-rates/",
              "host": ["{{base_url}}"],
              "path": ["api", "mi-product-rates", ""]
            }
          },
          "response": []
        },
        {
          "name": "2.3 List All Product Rates",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200 OK\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test(\"Response is an array of rates from Oracle DB\", function () {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData).to.be.an('array');",
                  "    pm.expect(jsonData.length).to.be.above(0);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/mi-product-rates/",
              "host": ["{{base_url}}"],
              "path": ["api", "mi-product-rates", ""]
            }
          },
          "response": []
        },
        {
          "name": "2.4 Search Product Rates by Keyword",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200 OK\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "var jsonData = pm.response.json();",
                  "pm.expect(jsonData).to.be.an('array');"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/mi-product-rates/?search=Enterprise",
              "host": ["{{base_url}}"],
              "path": ["api", "mi-product-rates", ""],
              "query": [
                {
                  "key": "search",
                  "value": "Enterprise"
                }
              ]
            }
          },
          "response": []
        },
        {
          "name": "2.5 Retrieve Single Rate by ID",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200 OK\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "var jsonData = pm.response.json();",
                  "pm.expect(jsonData.id).to.eql(pm.collectionVariables.get(\"record_id\"));"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/mi-product-rates/{{record_id}}/",
              "host": ["{{base_url}}"],
              "path": ["api", "mi-product-rates", "{{record_id}}", ""]
            }
          },
          "response": []
        },
        {
          "name": "2.6 Partial Update Rate (PATCH)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200 OK\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test(\"Fields updated properly in Oracle DB\", function () {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData.rate).to.eql(375000.00);",
                  "    pm.expect(jsonData.status).to.eql(\"Inactive\");",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"rate\": 375000.00,\n    \"status\": \"Inactive\",\n    \"comments\": \"Updated tariff via Postman test script\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/mi-product-rates/{{record_id}}/",
              "host": ["{{base_url}}"],
              "path": ["api", "mi-product-rates", "{{record_id}}", ""]
            }
          },
          "response": []
