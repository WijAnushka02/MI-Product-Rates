{
  "info": {
    "name": "MI Product Rates Management API (Oracle DB)",
    "_postman_id": "c6218f6c-843a-4efc-8b89-a5e2f750cfa8",
    "description": "Full Postman API collection for testing the MI Product Rates Management System built with Django REST Framework and Oracle Database.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "1. Create Product Rate (With File Upload)",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status code is 201 Created\", function () {",
              "    pm.response.to.have.status(201);",
              "});",
              "",
              "pm.test(\"SR_ID auto-generated in SR00X format\", function () {",
              "    var jsonData = pm.response.json();",
              "    pm.expect(jsonData.sr_id).to.match(/^SR\\d{3,}$/);",
              "    pm.collectionVariables.set(\"record_id\", jsonData.id);",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [],
        "body": {
          "mode": "formdata",
          "formdata": [
            {
              "key": "service",
              "value": "Dedicated Internet Access",
              "type": "text"
            },
            {
              "key": "executive_level",
              "value": "Enterprise Gold",
              "type": "text"
            },
            {
              "key": "rate",
              "value": "125000.50",
              "type": "text"
            },
            {
              "key": "created_user",
              "value": "anushka_intern",
              "type": "text"
            },
            {
              "key": "status",
              "value": "Active",
              "type": "text"
            },
            {
              "key": "comments",
              "value": "Annual commercial rate card Q1",
              "type": "text"
            },
            {
              "key": "attachment",
              "type": "file",
              "src": ""
            }
          ]
        },
        "url": {
          "raw": "{{base_url}}/api/mi-product-rates/",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "api",
            "mi-product-rates",
            ""
          ]
        }
      },
      "response": []
    },
