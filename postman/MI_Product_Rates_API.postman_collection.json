          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/mi-product-rates/{{record_id}}/download/",
              "host": ["{{base_url}}"],
              "path": ["api", "mi-product-rates", "{{record_id}}", "download", ""]
            }
          },
          "response": []
        },
        {
          "name": "2.8 Delete Rate Record (DELETE)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 204 No Content\", function () {",
                  "    pm.expect([200, 204]).to.include(pm.response.code);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/mi-product-rates/{{record_id}}/",
              "host": ["{{base_url}}"],
              "path": ["api", "mi-product-rates", "{{record_id}}", ""]
            }
          },
          "response": []
